# Local development only. Generate new values before starting the stack.
RUNSIGIL_ENVIRONMENT=development
RUNSIGIL_POSTGRES_OWNER_PASSWORD=change-me-owner
RUNSIGIL_POSTGRES_APP_PASSWORD=change-me-app
RUNSIGIL_POSTGRES_WORKER_PASSWORD=change-me-worker
RUNSIGIL_POSTGRES_GATEWAY_AUTH_PASSWORD=change-me-gateway-auth
RUNSIGIL_DATABASE_URL=postgresql+psycopg://runsigil_app:change-me-app@postgres:5432/runsigil
RUNSIGIL_WORKER_DATABASE_URL=postgresql+psycopg://runsigil_worker:change-me-worker@postgres:5432/runsigil
RUNSIGIL_GATEWAY_AUTHORIZATION_DATABASE_URL=postgresql+psycopg://runsigil_gateway_authorizer:change-me-gateway-auth@postgres:5432/runsigil
RUNSIGIL_MIGRATION_DATABASE_URL=postgresql+psycopg://runsigil_owner:change-me-owner@postgres:5432/runsigil
RUNSIGIL_REDIS_URL=redis://redis:6379/0
RUNSIGIL_OBJECT_STORE_ENDPOINT=http://minio:9000
RUNSIGIL_OBJECT_STORE_BUCKET=runsigil-evidence
RUNSIGIL_OBJECT_STORE_ACCESS_KEY=runsigil-dev
RUNSIGIL_OBJECT_STORE_SECRET_KEY=replace-me
RUNSIGIL_GATEWAY_URL=http://gateway:8080
RUNSIGIL_CONTROL_API_URL=http://control-api:8000
RUNSIGIL_GATEWAY_SERVICE_TOKEN=replace-with-32-or-more-random-characters
RUNSIGIL_INTERNAL_SERVICE_TOKEN=replace-with-a-different-32-character-random-value
RUNSIGIL_ACTION_ENCRYPTION_KEY_B64=replace-with-32-random-bytes-base64
RUNSIGIL_EVIDENCE_ED25519_PRIVATE_KEY_B64=replace-with-32-random-bytes-base64
RUNSIGIL_EVIDENCE_SIGNING_KEY_ID=development-2026-01
RUNSIGIL_DEMO_PROVIDER_URL=http://demo-provider:8090/effects
RUNSIGIL_DEMO_PROVIDER_AUDIENCE=runsigil-demo-provider
RUNSIGIL_DEMO_PROVIDER_SIGNING_KEY=replace-with-another-32-character-random-value
RUNSIGIL_ALLOW_PRIVATE_DEMO_PROVIDER=true
RUNSIGIL_PROTOCOL_PUBLIC_BASE_URL=http://localhost:8080
RUNSIGIL_PROTOCOL_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
RUNSIGIL_BOOTSTRAP_API_KEY=rsk_dev_replace_me
RUNSIGIL_OTEL_ENABLED=true
RUNSIGIL_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
RUNSIGIL_MAX_RECONCILIATION_ATTEMPTS=3
RUNSIGIL_MAX_DLQ_REDRIVES=2
